<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:id="@+id/navigation_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="8dp">
        <LinearLayout android:id="@+id/navigation_final_section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="2dp">
            <TextView android:id="@+id/navigation_final_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Final destination" android:textSize="12sp"
                android:labelFor="@id/navigation_status" />
            <TextView android:id="@+id/navigation_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navigation_restroom_section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="2dp">
            <TextView android:id="@+id/navigation_stop_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Restroom stop" android:textSize="12sp"
                android:labelFor="@id/navigation_restroom_stop" />
            <TextView android:id="@+id/navigation_restroom_stop" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="12dp" android:paddingBottom="8dp" android:baselineAligned="false">
        <Button android:id="@+id/navigation_stop" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:minHeight="52dp"
            android:layout_marginEnd="4dp" android:text="Stop Navigation" />
        <Button android:id="@+id/navigation_change" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="match_parent" android:minHeight="52dp"
            android:layout_marginStart="4dp" android:text="Change Stop" />
    </LinearLayout>
    <TextView android:id="@+id/navigation_message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="10dp"
        android:textSize="13sp" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/navigation_review" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Rate this restroom" android:visibility="gone" />
    <Button android:id="@+id/navigation_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Resume guidance" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <FrameLayout android:id="@+id/navigation_map_area" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1">
            <androidx.fragment.app.FragmentContainerView android:id="@+id/navigation_map"
                android:name="com.google.android.libraries.navigation.NavigationFragment"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageButton android:id="@+id/navigation_overview" android:layout_width="72dp"
                android:layout_height="72dp" android:layout_gravity="bottom|right"
                android:layout_marginRight="8dp" android:layout_marginBottom="80dp"
                android:src="@drawable/ic_route_overview" android:scaleType="fitCenter"
                android:background="@android:color/transparent" android:padding="0dp"
                android:contentDescription="Show route overview" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/navigation_eta" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp"
            android:paddingHorizontal="18dp" android:paddingVertical="10dp"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/navigation_eta_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="28sp"
                android:textStyle="bold" android:textColor="#FFFFFF" />
            <TextView android:id="@+id/navigation_eta_details" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
