<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/navigation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView
        android:id="@+id/navigation_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textSize="16sp"
        android:accessibilityLiveRegion="polite" />
    <Button
        android:id="@+id/navigation_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start guidance" />
    <Button
        android:id="@+id/navigation_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stop navigation" />
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navigation_map"
        android:name="com.google.android.libraries.navigation.NavigationFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
