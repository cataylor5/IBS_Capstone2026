# Copy to .env; do not commit .env. Node.js 20.6+ is required.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ibs
# Demo reviews only; must differ from PGDATABASE and end in _test.
PGREVIEW_TEST_DATABASE=ibs_reviews_test
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_RANDOM_32_BYTE_SECRET
# Enable Routes API and use a separate server-restricted key for route calculation.
GOOGLE_ROUTES_API_KEY=REPLACE_WITH_SERVER_ROUTES_API_KEY
HOST=127.0.0.1
PORT=3000
